# ==============================================================================
# ResumeAgent AI - Environment Secrets Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# 1. DO NOT commit production API keys or tokens into source control.
# 2. Copy this template to `.env.local` for local development.
# 3. All server-side secrets are isolated and never transmitted to the browser bundle.
# 4. If keys are entered via the web UI, they reside in client localStorage only.
# ==============================================================================

# Google Gemini API (Get key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI API (Get key: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic Claude API (Get key: https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# NVIDIA NIM API (Get key: https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Groq Cloud API (Get key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter Unified API (Get key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
